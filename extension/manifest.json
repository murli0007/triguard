{
  "manifest_version": 3,
  "name": "TriGuard",
  "version": "1.1.0",
  "description": "Local AI Security Lab — real-time URL and Gmail phishing checks powered by the TriGuard API.",
  "permissions": [
    "activeTab",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*",
    "http://localhost:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
